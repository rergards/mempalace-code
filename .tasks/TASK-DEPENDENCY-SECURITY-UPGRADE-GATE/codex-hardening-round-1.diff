+                results.append({"vulns": [{"id": "GHSA-f4j7-r4q5-qw2c"}]})
+            else:
+                results.append({"vulns": []})
+        return results
+
+    rc = gate.cmd_audit(
+        manifest_path=tmp_path / "manifest.json",
+        root=tmp_path,
+        slug="chroma-blocked",
+        advisory_querier=_chroma_one_x_affected,
